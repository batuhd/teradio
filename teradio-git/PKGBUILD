# Maintainer: Batuhan <batuhd@users.noreply.github.com>
# AUR paketi: teradio-git (git HEAD'den derler, sürüm numarası yok)
_app=teradio
pkgname=teradio-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Terminalde çalışan internet radyosu (ncspot tarzı, mpv tabanlı) — git sürümü"
arch=('any')
url="https://github.com/batuhd/teradio"
license=('MIT')
depends=('python' 'mpv')
makedepends=('git')
provides=("$_app")
conflicts=("$_app")
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$pkgname"
  python -m venv --clear "$srcdir/venv"
  "$srcdir/venv/bin/pip" install --no-compile --no-cache-dir .
}

package() {
  cd "$pkgname"

  install -d "$pkgdir/usr/lib/$_app"
  cp -a "$srcdir/venv/lib/"python*/site-packages/. "$pkgdir/usr/lib/$_app/"
  rm -rf "$pkgdir/usr/lib/$_app"/{pip,pip-*,setuptools,setuptools-*,pkg_resources,_distutils_hack,distutils-precedence.pth}
  find "$pkgdir/usr/lib/$_app" -name '__pycache__' -type d -prune -exec rm -rf {} +

  install -d "$pkgdir/usr/bin"
  printf '%s\n' \
    '#!/bin/sh' \
    'export PYTHONPATH="/usr/lib/teradio${PYTHONPATH:+:$PYTHONPATH}"' \
    'exec python3 -m teradio "$@"' \
    > "$pkgdir/usr/bin/$_app"
  chmod 755 "$pkgdir/usr/bin/$_app"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
